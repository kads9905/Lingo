# Copy to .env for local runs. On Render, add these under Environment instead.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional. Change these if a provider retires a model.
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash-lite
# Leave empty to run the PyTorch models inside the backend (needs about 3 GB of RAM).
ML_WORKER_URL=
WORKER_KEY=
ALLOWED_ORIGINS=http://localhost:5173
